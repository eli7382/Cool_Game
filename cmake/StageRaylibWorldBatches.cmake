# Keep upstream sources intact. Stage the build inputs, then correct the two
# uniforms used by rlgl's CPU-transformed immediate vertex batch. DrawMesh's
# per-mesh model/normal uploads in rmodels.c are deliberately unchanged.
function(stage_raylib_world_batches source destination)
  file(MAKE_DIRECTORY "${destination}")
  file(COPY "${source}/src" "${source}/cmake" DESTINATION "${destination}"
       PATTERN "rlgl.h" EXCLUDE)
  foreach(name CMakeLists.txt CMakeOptions.txt raylib.pc.in README.md LICENSE)
    file(COPY "${source}/${name}" DESTINATION "${destination}")
  endforeach()
  file(READ "${source}/src/rlgl.h" header)
  set(old_model "glUniformMatrix4fv(RLGL.State.currentShaderLocs[RL_SHADER_LOC_MATRIX_MODEL], 1, false, rlMatrixToFloat(RLGL.State.transform));")
  set(old_normal "glUniformMatrix4fv(RLGL.State.currentShaderLocs[RL_SHADER_LOC_MATRIX_NORMAL], 1, false, rlMatrixToFloat(rlMatrixTranspose(rlMatrixInvert(RLGL.State.transform))));")
  foreach(pattern IN ITEMS old_model old_normal)
    string(REPLACE "${${pattern}}" "" without "${header}")
    string(LENGTH "${header}" before_length)
    string(LENGTH "${without}" after_length)
    string(LENGTH "${${pattern}}" pattern_length)
    math(EXPR difference "${before_length}-${after_length}")
    if(NOT difference EQUAL pattern_length)
      message(FATAL_ERROR "Expected exactly one raylib 5.5 batch uniform ${pattern}; source requires review")
    endif()
  endforeach()
  set(new_model "// BREAKWATER PATCH: batch positions/normals already carry CPU stack transforms.\n                glUniformMatrix4fv(RLGL.State.currentShaderLocs[RL_SHADER_LOC_MATRIX_MODEL], 1, false, rlMatrixToFloat(rlMatrixIdentity()));")
  set(new_normal "glUniformMatrix4fv(RLGL.State.currentShaderLocs[RL_SHADER_LOC_MATRIX_NORMAL], 1, false, rlMatrixToFloat(rlMatrixIdentity()));")
  string(REPLACE "${old_model}" "${new_model}" header "${header}")
  string(REPLACE "${old_normal}" "${new_normal}" header "${header}")
  set(output "${destination}/src/rlgl.h")
  set(previous "")
  if(EXISTS "${output}")
    file(READ "${output}" previous)
  endif()
  if(NOT previous STREQUAL header)
    file(WRITE "${output}" "${header}")
  endif()
  file(SHA256 "${source}/src/rlgl.h" source_sha)
  file(SHA256 "${output}" staged_sha)
  file(WRITE "${CMAKE_BINARY_DIR}/raylib-world-space-patch.json"
       "{\"upstream_rlgl_sha256\":\"${source_sha}\",\"staged_rlgl_sha256\":\"${staged_sha}\",\"upstream_modified\":false,\"batch_model_and_normal_are_identity\":true}\n")
endfunction()
